# Build / IDE / per-machine noise — common across all IceSpiritAI_* repos.
# Domain-specific rules (model staging, mirror staging, etc.) intentionally omitted
# for the initial Vision scaffold; add when needed.

# Per-machine ad-hoc test fixtures (real-device photos + transcriptions).
# 2026-08-21: never stage these — they contain real OCR captures and
# research notes that should stay local.
测试集/

# Historical release APK archive. The Gradle release pipeline no longer
# writes here as of 2026-08-21 (staging moved to build/generated/release-staging/),
# but the directory persists on disk with prior releases. Keep ignored so
# it doesn't pollute git status.
发布版历史存档/

# .claude/ holds both per-machine transient state AND project-shared automation.
# Allow the project-shared surface; ignore the rest.
.claude/home_*.png
.claude/main_*.png
.claude/scheduled_tasks.lock
.claude/worktrees/
.claude/scratch/
.claude/settings.local.json

.kilo/
.gradle/
.idea/
.kotlin/
build/
app/.cxx/
local.properties
captures/
*.iml
.git-backup/
verification-results/
hs_err_pid*.log
replay_pid*.log
.model-download-cache/
tmp/
tmp_run/

# Python bytecode caches (tools/*.py and any future scripts).
**/__pycache__/

# VS Code workspace settings.
.vscode/

# Local MCP server config (per-machine bootstrap commands).
.mcp.json

# Superpowers brainstorming scratch (per-session).
.superpowers/

# Standard local-only artefacts
.DS_Store
Thumbs.db

# Generated docs artefacts (binary derivatives of tracked sources).
docs/*.docx
docs/*.pdf
*.bak
*~
.sw?

# Build / install / debug log files.
*.log
install.log

# Ad-hoc screenshots and UI dumps used during development.
/current_*.png
/v2_*.png
/proof.png
/final_*.png
/home*.png
/main*.png
/now.png
/state.png
/ui[0-9]*.xml
/d
/dump.xml
/garbled.*
/smoke_test.ps1
/check_artifacts.ps1

# Claude review scratch files.
review_committed.diff
review_uncommitted.diff
logcat_output.txt

.idea/workspace.xml
.idea/tasks.xml
.idea/usage.statistics.xml
.idea/dictionaries/
.idea/caches/
.idea/libraries/
.idea/gradle.xml
.idea/navEditor.xml
.idea/assetWizardSettings.xml

# uploadVisionReleaseToGitea Gradle task reads this for the Gitea PAT.
# Tracked: gradle.token.properties.example (template).
# Untracked: gradle.token.properties (contains the real PAT).
# gradle.properties remains tracked (shared JVM args + Kotlin config).
gradle.token.properties

# PaddleOCR SDK build artifacts (regenerable via tools/build-ppocr-sdk.sh)
tools/paddleocr/
app/libs/ppocr-sdk.aar
app/libs/ppocr-sdk-release.aar

# ONNX model weights (regenerable via tools/download-ppocr-models.sh).
# Use ** so the patterns catch nested extraction paths, not just direct
# children of det/ and rec/.
app/src/main/assets/models/**/*.onnx
app/src/main/assets/models/**/*.yml
app/src/main/assets/models/**/*.tar
app/src/main/assets/models/**/*.md
app/src/main/assets/models/**/.gitattributes
app/src/main/assets/models/**/*.cache/

# Wide-pattern coverage so future-named files don't slip in by accident.
# The specific names elsewhere in this file still act as a backstop for
# existing paths (e.g. `gradle.token.properties` listed above).
*.aar
*.keystore
*.token.properties
gradle.properties.local
release.keystore

# audit66 OCR fixtures — recorded locally by tools/ocr-audit66-fixtures.py; regenerable.
app/src/test/resources/fixtures/audit66_ocr/
