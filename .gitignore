# Stale release JSON that landed in repo root from a previous release.
# The release pipeline writes to build/generated/release-staging/ now
# (per memory feedback-no-release-history-archive); anything at the
# repo root is leftover from before that move.
/vision-latest.json

# Smoke verify runtime evidence — logcat captures + UI dumps collected
# during real-device testing. Only the per-session README.md commits
# (under docs/smoke/<date>-*/); the raw .txt and .xml artifacts stay
# local because they reference test-time internal state and are
# regenerated on every smoke run.
docs/smoke/*/logcat*.txt
docs/smoke/*/logcat*.out
docs/smoke/*/ui*.xml

# Claude review scratch files.
review_committed.diff
review_uncommitted.diff
logcat_output.txt

.idea/workspace.xml
.idea/tasks.xml
.idea/usage.statistics.xml
.idea/dictionaries/
.idea/caches/
.idea/libraries/
.idea/gradle.xml
.idea/navEditor.xml
.idea/assetWizardSettings.xml

# uploadVisionReleaseToGitea Gradle task reads this for the Gitea PAT.
# Tracked: gradle.token.properties.example (template).
# Untracked: gradle.token.properties (contains the real PAT).
# gradle.properties remains tracked (shared JVM args + Kotlin config).
#
# 凭据隔离警告 (2026-09-16):
# gradle.token.properties 是 PAT 单一来源 —— `uploadVisionReleaseToGitea`
# Gradle task 读 GITEA_TOKEN 走这里,git push gitea 也走这里(经 inline
# shell-script credential helper,见 .claude/projects/.../memory/)。
#
# 不要改名(`.gitignore` 显式列出 + pre-tool-use hook 按字面路径匹配 +
# post-tool-use hook 也按字面路径扫,改名 = 失去双重防护)。
# 不要 commit。Pre-tool-use hook 会拦截。Post-tool-use hook 也会拦。
# 如果文件丢失,在 giteaadmin/user/settings/applications mint 新 PAT 重建。
gradle.token.properties

# PaddleOCR SDK build artifacts (regenerable via tools/build-ppocr-sdk.sh)
tools/paddleocr/
app/libs/ppocr-sdk.aar
app/libs/ppocr-sdk-release.aar

# ONNX model weights (regenerable via tools/download-ppocr-models.sh).
# Use ** so the patterns catch nested extraction paths, not just direct
# children of det/ and rec/.
app/src/main/assets/models/**/*.onnx
app/src/main/assets/models/**/*.yml
app/src/main/assets/models/**/*.tar
app/src/main/assets/models/**/*.md
app/src/main/assets/models/**/.gitattributes
app/src/main/assets/models/**/*.cache/

# Wide-pattern coverage so future-named files don't slip in by accident.
# The specific names elsewhere in this file still act as a backstop for
# existing paths (e.g. `gradle.token.properties` listed above).
*.aar
*.keystore
*.token.properties
gradle.properties.local
release.keystore

# audit66 OCR fixtures — recorded locally by tools/ocr-audit66-fixtures.py; regenerable.
app/src/test/resources/fixtures/audit66_ocr/

# Local worktree directories (subagent-driven plan execution)
.worktrees/

# Per-version debug screenshot/UI dump/logcat dumps collected during
# real-device debugging. Stay local — they're scratch not source.
_screenshots/

# Local audit scratch — one-off scripts that scan rules.json + KB and
# dump JSON reports. Output is regenerable by re-running the script;
# the scripts themselves rarely warrant committing. If a particular
# .tmp_audit subdir stabilizes into a real tool, move it to tools/ and
# add a tracked entry instead.
.tmp_audit/
