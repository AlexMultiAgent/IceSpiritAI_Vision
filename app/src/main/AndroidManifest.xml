<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 11 (API 30) package visibility: callers can only resolve
         other apps' intent filters when the relevant intent / provider /
         package is whitelisted in a <queries> block. Without this, system
         camera and gallery activities show up as `resolveActivity = null`
         on API 30+ strict vendors (HarmonyOS / One UI / MIUI), surfacing
         as `ActivityNotFoundException` from the picker launcher.
         PhotoPicker (ActivityResultContracts.PickVisualMedia) bypasses
         this check via a system-level UI, but the SAF / gallery / install
         fallback paths still need it. Listed intents:
           - IMAGE_CAPTURE:        back camera intent fallback
           - PICK (image/*):       system gallery PICK fallback
           - GET_CONTENT (image/*):generi file picker fallback
           - INSTALL_PACKAGE:      UpdateDownloadService install flow -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.PICK" />
            <data android:mimeType="image/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.GET_CONTENT" />
            <data android:mimeType="image/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.INSTALL_PACKAGE" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- required by Coil 2.7 NetworkObserver for cache invalidation -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- UpdateDownloadService: foreground-service download pipeline (Android 13+ / 14+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".IceSpiritApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.IceSpiritOffline">

        <activity
            android:name=".IceSpiritVisionActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>

        <service
            android:name=".updater.service.UpdateDownloadService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

    </application>

</manifest>
