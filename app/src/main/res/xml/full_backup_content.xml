<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 之前的备份规则。Android 12+ 走 data_extraction_rules.xml。

  与 AndroidManifest.xml 里 `android:fullBackupContent="@xml/full_backup_content"`
  + `android:allowBackup="false"` 配合:Android < 12 上 allowBackup="false"
  仍然使本资源不被解析(整个备份路径都不进),但显式声明可消
  lint [DataExtractionRules] 提示 "since minSdkVersion is API 26 you should
  also set android:fullBackupContent"。

  exclude domain 与 data_extraction_rules.xml 对齐:根目录 / file / database /
  sharedpref / external 全排除 —— 与 allowBackup="false" 语义一致。
-->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>