<!--
  Smart-glasses icon for the "眼镜" CaptureBar FAB (redrawn 2026-09-17).

  v1 was two rings plus a 3px bridge: at FAB scale it read as "∞" / a pair of
  eyes, and it carried less visual weight than the Material filled icons next
  to it (`PhotoLibrary`, `Save`).

  v2 (this file) is drawn on the same 24dp grid with a uniform 2dp stroke:
  two rounded-rectangle lenses, a real nose-bridge arc, and two temple arms
  angled up to the canvas edges. The arms are the cue that turns "∞" into
  "a pair of glasses"; a first attempt also added a small "smart" dot on the
  right temple, but at 24dp it merged with the arm into a smudge (checked on
  device), so the glyph stays clean instead.

  Everything stays inside x∈[1.2,22.8], y∈[8.2,16.6] so the 2dp stroke is
  never clipped. fillColor is unused (all paths are stroked) and is only set
  for tooling that requires the attribute; Compose `Icon` tints the whole
  drawable with `LocalContentColor` at render time.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Left lens: rounded rectangle, 8.6 x 6.8, corner radius 3.2. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF666666"
        android:strokeWidth="2.0"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M5.8,9.6 L8.0,9.6 A3.2,3.2 0 0 1 11.2,12.8 L11.2,13.2 A3.2,3.2 0 0 1 8.0,16.4 L5.8,16.4 A3.2,3.2 0 0 1 2.6,13.2 L2.6,12.8 A3.2,3.2 0 0 1 5.8,9.6 Z" />

    <!-- Right lens. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF666666"
        android:strokeWidth="2.0"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M16.0,9.6 L18.2,9.6 A3.2,3.2 0 0 1 21.4,12.8 L21.4,13.2 A3.2,3.2 0 0 1 18.2,16.4 L16.0,16.4 A3.2,3.2 0 0 1 12.8,13.2 L12.8,12.8 A3.2,3.2 0 0 1 16.0,9.6 Z" />

    <!-- Nose bridge. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF666666"
        android:strokeWidth="2.0"
        android:strokeLineCap="round"
        android:pathData="M11.2,11.4 C11.7,10.9 12.3,10.9 12.8,11.4" />

    <!-- Temple arms. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF666666"
        android:strokeWidth="2.0"
        android:strokeLineCap="round"
        android:pathData="M2.8,10.7 L1.4,8.8" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF666666"
        android:strokeWidth="2.0"
        android:strokeLineCap="round"
        android:pathData="M21.2,10.7 L22.6,8.8" />
</vector>
